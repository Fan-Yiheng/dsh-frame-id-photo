{
  "name": "@local/frame-photo-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "description": "DeepSeek Harness sidebar plugin for precise ID-photo cropping (social security card, passport, visa, and more).",
  "license": "MIT",
  "author": "Fan Yiheng",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "id-photo",
    "crop",
    "canvas"
  ]
}
